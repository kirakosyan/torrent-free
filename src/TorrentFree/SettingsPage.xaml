<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TorrentFree.ViewModels"
             xmlns:helpers="clr-namespace:TorrentFree.Helpers"
             x:Class="TorrentFree.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundColorLight}, Dark={StaticResource PageBackgroundColorDark}}"
             Shell.NavBarIsVisible="False"
             Title="{helpers:Translate SettingsTitle}">

       <ScrollView>
              <VerticalStackLayout Padding="16"
                                   Spacing="16">
                     <Grid ColumnDefinitions="Auto,*"
                           ColumnSpacing="12">
                            <Button x:Name="BackButton"
                                    Grid.Column="0"
                                    Text="←"
                                    Clicked="OnBackClicked"
                                    SemanticProperties.Description="{helpers:Translate GoBack}"
                                    FontSize="20"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    CornerRadius="14"
                                    Padding="0"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#17202D}"
                                    TextColor="{AppThemeBinding Light=#55627A, Dark=#E2E8F0}"
                                    BorderColor="{AppThemeBinding Light=#D6DEEA, Dark=#334155}"
                                    BorderWidth="1"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Start"/>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4">
                                   <Label Text="{helpers:Translate SettingsTitle, StringFormat='⚙️ {0}'}"
                                          FontSize="22"
                                          FontAttributes="Bold"/>
                                   <Label Text="{helpers:Translate AutoSaveNote}"
                                          FontSize="12"
                                          TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                            </VerticalStackLayout>
                     </Grid>

                     <!-- Language -->
                     <Border Padding="16"
                             Stroke="Transparent"
                             Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Text="{helpers:Translate LanguageLabel, StringFormat='🌐 {0}'}"
                                          FontSize="14"
                                          FontAttributes="Bold"/>
                                    <Picker Grid.Row="1"
                                            ItemsSource="{Binding AvailableLanguages}"
                                            SelectedItem="{Binding SelectedLanguage}"
                                            SemanticProperties.Description="{helpers:Translate LanguageLabel}"
                                            SemanticProperties.Hint="{helpers:Translate LanguagePickerHint}"/>
                            </Grid>
                     </Border>

                     <Border Padding="16"
                             Stroke="Transparent"
                             Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="Auto,*"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Grid.ColumnSpan="2"
                                          Text="{helpers:Translate DownloadLocation}"
                                          FontSize="14"
                                          FontAttributes="Bold"/>

                                    <CheckBox Grid.Row="1"
                                              Grid.Column="0"
                                              IsChecked="{Binding DownloadToTorrentFolder}"
                                             SemanticProperties.Description="{helpers:Translate DownloadToTorrentFolderLabel}"/>
                                   <Label Grid.Row="1"
                                          Grid.Column="1"
                                          Text="{helpers:Translate DownloadToTorrentFolderLabel}"
                                          VerticalOptions="Center"
                                          FontSize="12"
                                          TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>

                                   <VerticalStackLayout Grid.Row="2"
                                                        Grid.ColumnSpan="2"
                                                        Spacing="4"
                                                        IsVisible="{Binding UseSpecificDownloadFolder}">
                                          <Label Text="{helpers:Translate SpecificDownloadFolderLabel}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Grid ColumnDefinitions="*,Auto"
                                                ColumnSpacing="8">
                                                  <Entry Grid.Column="0"
                                                         Text="{Binding SpecificDownloadFolder}"
                                                        SemanticProperties.Description="{helpers:Translate SpecificDownloadFolderLabel}"
                                                        SemanticProperties.Hint="{helpers:Translate SpecificDownloadFolderPlaceholder}"
                                                        Placeholder="{helpers:Translate SpecificDownloadFolderPlaceholder}"/>
                                                  <Button Grid.Column="1"
                                                          Text="{helpers:Translate BrowseButton}"
                                                          Command="{Binding BrowseDownloadFolderCommand}"
                                                          IsVisible="{Binding IsFolderPickerSupported}"
                                                         SemanticProperties.Description="{helpers:Translate BrowseButton}"/>
                                          </Grid>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Row="3"
                                                        Grid.ColumnSpan="2"
                                                        Spacing="8"
                                                        IsVisible="{Binding IsAndroid}">
                                          <Label Text="{helpers:Translate AndroidDownloadFolderHelp}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Button Text="{helpers:Translate OpenDownloadsFolder}"
                                                  Command="{Binding OpenAndroidDownloadsFolderCommand}"
                                                  HorizontalOptions="Start"
                                                  SemanticProperties.Description="{helpers:Translate OpenDownloadsFolder}"/>
                                   </VerticalStackLayout>
                            </Grid>
                     </Border>

                     <Border Padding="16"
                             Stroke="Transparent"
                             Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Grid.ColumnSpan="2"
                                          Text="{helpers:Translate SpeedLimits}"
                                          FontSize="14"
                                          FontAttributes="Bold"/>

                                   <VerticalStackLayout Grid.Row="1"
                                                        Grid.Column="0"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate DownloadKBs, StringFormat='⬇️ {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                           <Entry Text="{Binding GlobalDownloadLimitKbps}"
                                                 SemanticProperties.Description="{helpers:Translate DownloadKBs}"
                                                 SemanticProperties.Hint="{helpers:Translate UnlimitedHint}"
                                                  Keyboard="Numeric"
                                                 Placeholder="{helpers:Translate UnlimitedHint}"
                                                 TextChanged="OnNumericTextChanged"/>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Row="1"
                                                        Grid.Column="1"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate UploadKBs, StringFormat='⬆️ {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                           <Entry Text="{Binding GlobalUploadLimitKbps}"
                                                 SemanticProperties.Description="{helpers:Translate UploadKBs}"
                                                 SemanticProperties.Hint="{helpers:Translate UnlimitedHint}"
                                                  Keyboard="Numeric"
                                                 Placeholder="{helpers:Translate UnlimitedHint}"
                                                 TextChanged="OnNumericTextChanged"/>
                                   </VerticalStackLayout>
                            </Grid>
                          </Border>

                          <Border Padding="16"
                                 Stroke="Transparent"
                                 Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                                 IsVisible="{Binding IsFileAssociationSupported}">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Grid.ColumnSpan="2"
                                          Text="{helpers:Translate FileAssociations}"
                                          FontSize="14"
                                          FontAttributes="Bold"/>
                                   <Label Grid.Row="1"
                                          Grid.Column="0"
                                          Text="{helpers:Translate AssociateTorrentFiles}"
                                          FontSize="12"
                                          TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                    <Switch Grid.Row="1"
                                            Grid.Column="1"
                                            IsToggled="{Binding IsTorrentAssociated}"
                                           SemanticProperties.Description="{helpers:Translate AssociateTorrentFiles}"
                                           SemanticProperties.Hint="{helpers:Translate AssociateTorrentMessage}"/>
                            </Grid>
                     </Border>

                     <Border Padding="16"
                             Stroke="Transparent"
                             Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Grid.ColumnSpan="2"
                                          Text="{helpers:Translate QueueLimits}"
                                          FontSize="14"
                                          FontAttributes="Bold"/>

                                   <VerticalStackLayout Grid.Row="1"
                                                        Grid.Column="0"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate MaxActiveDownloads, StringFormat='⬇️ {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                           <Entry Text="{Binding MaxActiveDownloads}"
                                                 SemanticProperties.Description="{helpers:Translate MaxActiveDownloads}"
                                                 SemanticProperties.Hint="{helpers:Translate UnlimitedHint}"
                                                  Keyboard="Numeric"
                                                 Placeholder="{helpers:Translate UnlimitedHint}"
                                                 TextChanged="OnNumericTextChanged"/>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Row="1"
                                                        Grid.Column="1"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate MaxActiveSeeds, StringFormat='🌱 {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                           <Entry Text="{Binding MaxActiveSeeds}"
                                                 SemanticProperties.Description="{helpers:Translate MaxActiveSeeds}"
                                                 SemanticProperties.Hint="{helpers:Translate UnlimitedHint}"
                                                  Keyboard="Numeric"
                                                 Placeholder="{helpers:Translate UnlimitedHint}"
                                                 TextChanged="OnNumericTextChanged"/>
                                   </VerticalStackLayout>
                            </Grid>
                     </Border>

                     <Border Padding="16"
                             Stroke="Transparent"
                             Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Grid.ColumnSpan="2"
                                          Text="{helpers:Translate SeedingLimits}"
                                          FontSize="14"
                                          FontAttributes="Bold"/>

                                   <VerticalStackLayout Grid.Row="1"
                                                        Grid.Column="0"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate MaxSeedRatio, StringFormat='📊 {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                           <Entry Text="{Binding GlobalMaxSeedRatio}"
                                                 SemanticProperties.Description="{helpers:Translate MaxSeedRatio}"
                                                 SemanticProperties.Hint="{helpers:Translate UnlimitedHint}"
                                                  Keyboard="Numeric"
                                                 Placeholder="{helpers:Translate UnlimitedHint}"
                                                 TextChanged="OnDecimalTextChanged"/>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Row="1"
                                                        Grid.Column="1"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate MaxSeedMinutes, StringFormat='⏱️ {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                           <Entry Text="{Binding GlobalMaxSeedMinutes}"
                                                 SemanticProperties.Description="{helpers:Translate MaxSeedMinutes}"
                                                 SemanticProperties.Hint="{helpers:Translate UnlimitedHint}"
                                                  Keyboard="Numeric"
                                                 Placeholder="{helpers:Translate UnlimitedHint}"
                                                 TextChanged="OnNumericTextChanged"/>
                                   </VerticalStackLayout>
                            </Grid>
                     </Border>

                     <!-- Proxy Settings -->
                     <Border Padding="16"
                             Stroke="Transparent"
                             Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Grid.ColumnSpan="2"
                                          Text="{helpers:Translate Socks5Proxy}"
                                          FontSize="14"
                                          FontAttributes="Bold"/>

                                   <HorizontalStackLayout Grid.Row="1"
                                                          Grid.ColumnSpan="2"
                                                          Spacing="8">
                                           <Switch IsToggled="{Binding ProxyEnabled}"
                                                  SemanticProperties.Description="{helpers:Translate EnableProxy}"/>
                                          <Label Text="{helpers:Translate EnableProxy}"
                                                 VerticalOptions="Center"
                                                 FontSize="13"/>
                                   </HorizontalStackLayout>

                                   <VerticalStackLayout Grid.Row="2"
                                                        Grid.Column="0"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate Host, StringFormat='🌐 {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                           <Entry Text="{Binding ProxyHost}"
                                                 SemanticProperties.Description="{helpers:Translate Host}"
                                                 SemanticProperties.Hint="{helpers:Translate ProxyHostHint}"
                                                 Placeholder="{helpers:Translate ProxyHostPlaceholder}"
                                                 IsEnabled="{Binding ProxyEnabled}"/>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Row="2"
                                                        Grid.Column="1"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate Port, StringFormat='🔌 {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                           <Entry Text="{Binding ProxyPort}"
                                                 SemanticProperties.Description="{helpers:Translate Port}"
                                                 SemanticProperties.Hint="{helpers:Translate ProxyPortHint}"
                                                 Keyboard="Numeric"
                                                 Placeholder="1080"
                                                 IsEnabled="{Binding ProxyEnabled}"
                                                 TextChanged="OnNumericTextChanged"/>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Row="3"
                                                        Grid.Column="0"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate Username, StringFormat='👤 {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                           <Entry Text="{Binding ProxyUsername}"
                                                 SemanticProperties.Description="{helpers:Translate Username}"
                                                 SemanticProperties.Hint="{helpers:Translate ProxyUsernameHint}"
                                                 Placeholder="{helpers:Translate OptionalPlaceholder}"
                                                 IsEnabled="{Binding ProxyEnabled}"/>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Row="3"
                                                        Grid.Column="1"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate Password, StringFormat='🔒 {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                           <Entry Text="{Binding ProxyPassword}"
                                                 SemanticProperties.Description="{helpers:Translate Password}"
                                                 SemanticProperties.Hint="{helpers:Translate ProxyPasswordHint}"
                                                 Placeholder="{helpers:Translate OptionalPlaceholder}"
                                                 IsPassword="True"
                                                 IsEnabled="{Binding ProxyEnabled}"/>
                                   </VerticalStackLayout>
                            </Grid>
                     </Border>

                      <Label Text="{Binding ValidationMessage}"
                             SemanticProperties.Description="{helpers:Translate SettingsValidationMessage}"
                             TextColor="{StaticResource StatusFailed}"
                            IsVisible="{Binding ValidationMessage, Converter={StaticResource StringNotEmptyConverter}}"
                            FontSize="12"/>
              </VerticalStackLayout>
       </ScrollView>

</ContentPage>
