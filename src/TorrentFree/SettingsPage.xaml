<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TorrentFree.ViewModels"
             xmlns:helpers="clr-namespace:TorrentFree.Helpers"
             x:Class="TorrentFree.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundColorLight}, Dark={StaticResource PageBackgroundColorDark}}"
             Title="{helpers:Translate SettingsTitle}">

       <ScrollView>
              <VerticalStackLayout Padding="16"
                                   Spacing="16">
                     <Label Text="{helpers:Translate SettingsTitle, StringFormat='⚙️ {0}'}"
                            FontSize="22"
                            FontAttributes="Bold"/>

                     <Label Text="{helpers:Translate AutoSaveNote}"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>

                     <!-- Language -->
                     <Border Padding="16"
                             Stroke="Transparent"
                             Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Text="{helpers:Translate LanguageLabel, StringFormat='🌐 {0}'}"
                                          FontSize="14"
                                          FontAttributes="Bold"/>
                                   <Picker Grid.Row="1"
                                           ItemsSource="{Binding AvailableLanguages}"
                                           SelectedItem="{Binding SelectedLanguage}"
                                           SemanticProperties.Description="Select application language"
                                           SemanticProperties.Hint="Choose system default or a specific language"/>
                            </Grid>
                     </Border>

                     <Border Padding="16"
                             Stroke="Transparent"
                             Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="Auto,*"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Grid.ColumnSpan="2"
                                          Text="{helpers:Translate DownloadLocation}"
                                          FontSize="14"
                                          FontAttributes="Bold"/>

                                   <CheckBox Grid.Row="1"
                                             Grid.Column="0"
                                             IsChecked="{Binding DownloadToTorrentFolder}"
                                             SemanticProperties.Description="Use the original torrent file folder for downloads"/>
                                   <Label Grid.Row="1"
                                          Grid.Column="1"
                                          Text="{helpers:Translate DownloadToTorrentFolderLabel}"
                                          VerticalOptions="Center"
                                          FontSize="12"
                                          TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>

                                   <VerticalStackLayout Grid.Row="2"
                                                        Grid.ColumnSpan="2"
                                                        Spacing="4"
                                                        IsVisible="{Binding UseSpecificDownloadFolder}">
                                          <Label Text="{helpers:Translate SpecificDownloadFolderLabel}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Grid ColumnDefinitions="*,Auto"
                                                ColumnSpacing="8">
                                                 <Entry Grid.Column="0"
                                                        Text="{Binding SpecificDownloadFolder}"
                                                        SemanticProperties.Description="Custom download folder path"
                                                        SemanticProperties.Hint="Enter the folder where new downloads should be saved"
                                                        Placeholder="{helpers:Translate SpecificDownloadFolderPlaceholder}"/>
                                                 <Button Grid.Column="1"
                                                         Text="{helpers:Translate BrowseButton}"
                                                         Command="{Binding BrowseDownloadFolderCommand}"
                                                         IsVisible="{Binding IsFolderPickerSupported}"
                                                         SemanticProperties.Description="Browse for a custom download folder"/>
                                          </Grid>
                                   </VerticalStackLayout>
                            </Grid>
                     </Border>

                     <Border Padding="16"
                             Stroke="Transparent"
                             Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Grid.ColumnSpan="2"
                                          Text="{helpers:Translate SpeedLimits}"
                                          FontSize="14"
                                          FontAttributes="Bold"/>

                                   <VerticalStackLayout Grid.Row="1"
                                                        Grid.Column="0"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate DownloadKBs, StringFormat='⬇️ {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding GlobalDownloadLimitKbps}"
                                                 SemanticProperties.Description="Global download speed limit in kilobytes per second"
                                                 SemanticProperties.Hint="Enter zero for unlimited"
                                                 Keyboard="Numeric"
                                                 Placeholder="{helpers:Translate UnlimitedHint}"
                                                 TextChanged="OnNumericTextChanged"/>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Row="1"
                                                        Grid.Column="1"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate UploadKBs, StringFormat='⬆️ {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding GlobalUploadLimitKbps}"
                                                 SemanticProperties.Description="Global upload speed limit in kilobytes per second"
                                                 SemanticProperties.Hint="Enter zero for unlimited"
                                                 Keyboard="Numeric"
                                                 Placeholder="{helpers:Translate UnlimitedHint}"
                                                 TextChanged="OnNumericTextChanged"/>
                                   </VerticalStackLayout>
                            </Grid>
                          </Border>

                          <Border Padding="16"
                                 Stroke="Transparent"
                                 Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                                 IsVisible="{Binding IsFileAssociationSupported}">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Grid.ColumnSpan="2"
                                          Text="{helpers:Translate FileAssociations}"
                                          FontSize="14"
                                          FontAttributes="Bold"/>
                                   <Label Grid.Row="1"
                                          Grid.Column="0"
                                          Text="{helpers:Translate AssociateTorrentFiles}"
                                          FontSize="12"
                                          TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                   <Switch Grid.Row="1"
                                           Grid.Column="1"
                                           IsToggled="{Binding IsTorrentAssociated}"
                                           SemanticProperties.Description="Associate torrent files with Torrent Free"
                                           SemanticProperties.Hint="Turn on to open .torrent files with this app"/>
                            </Grid>
                     </Border>

                     <Border Padding="16"
                             Stroke="Transparent"
                             Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Grid.ColumnSpan="2"
                                          Text="{helpers:Translate QueueLimits}"
                                          FontSize="14"
                                          FontAttributes="Bold"/>

                                   <VerticalStackLayout Grid.Row="1"
                                                        Grid.Column="0"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate MaxActiveDownloads, StringFormat='⬇️ {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding MaxActiveDownloads}"
                                                 SemanticProperties.Description="Maximum number of active downloads"
                                                 SemanticProperties.Hint="Enter zero for unlimited"
                                                 Keyboard="Numeric"
                                                 Placeholder="{helpers:Translate UnlimitedHint}"
                                                 TextChanged="OnNumericTextChanged"/>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Row="1"
                                                        Grid.Column="1"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate MaxActiveSeeds, StringFormat='🌱 {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding MaxActiveSeeds}"
                                                 SemanticProperties.Description="Maximum number of active seed jobs"
                                                 SemanticProperties.Hint="Enter zero for unlimited"
                                                 Keyboard="Numeric"
                                                 Placeholder="{helpers:Translate UnlimitedHint}"
                                                 TextChanged="OnNumericTextChanged"/>
                                   </VerticalStackLayout>
                            </Grid>
                     </Border>

                     <Border Padding="16"
                             Stroke="Transparent"
                             Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Grid.ColumnSpan="2"
                                          Text="{helpers:Translate SeedingLimits}"
                                          FontSize="14"
                                          FontAttributes="Bold"/>

                                   <VerticalStackLayout Grid.Row="1"
                                                        Grid.Column="0"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate MaxSeedRatio, StringFormat='📊 {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding GlobalMaxSeedRatio}"
                                                 SemanticProperties.Description="Global maximum seed ratio"
                                                 SemanticProperties.Hint="Enter zero for unlimited"
                                                 Keyboard="Numeric"
                                                 Placeholder="{helpers:Translate UnlimitedHint}"
                                                 TextChanged="OnDecimalTextChanged"/>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Row="1"
                                                        Grid.Column="1"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate MaxSeedMinutes, StringFormat='⏱️ {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding GlobalMaxSeedMinutes}"
                                                 SemanticProperties.Description="Global maximum seed minutes"
                                                 SemanticProperties.Hint="Enter zero for unlimited"
                                                 Keyboard="Numeric"
                                                 Placeholder="{helpers:Translate UnlimitedHint}"
                                                 TextChanged="OnNumericTextChanged"/>
                                   </VerticalStackLayout>
                            </Grid>
                     </Border>

                     <!-- Proxy Settings -->
                     <Border Padding="16"
                             Stroke="Transparent"
                             Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Grid.ColumnSpan="2"
                                          Text="{helpers:Translate Socks5Proxy}"
                                          FontSize="14"
                                          FontAttributes="Bold"/>

                                   <HorizontalStackLayout Grid.Row="1"
                                                          Grid.ColumnSpan="2"
                                                          Spacing="8">
                                          <Switch IsToggled="{Binding ProxyEnabled}"
                                                  SemanticProperties.Description="Enable SOCKS5 proxy"/>
                                          <Label Text="{helpers:Translate EnableProxy}"
                                                 VerticalOptions="Center"
                                                 FontSize="13"/>
                                   </HorizontalStackLayout>

                                   <VerticalStackLayout Grid.Row="2"
                                                        Grid.Column="0"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate Host, StringFormat='🌐 {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding ProxyHost}"
                                                 SemanticProperties.Description="SOCKS5 proxy host address"
                                                 SemanticProperties.Hint="Enter proxy host or IP"
                                                 Placeholder="e.g. 127.0.0.1"
                                                 IsEnabled="{Binding ProxyEnabled}"/>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Row="2"
                                                        Grid.Column="1"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate Port, StringFormat='🔌 {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding ProxyPort}"
                                                 SemanticProperties.Description="SOCKS5 proxy port"
                                                 SemanticProperties.Hint="Enter proxy port number"
                                                 Keyboard="Numeric"
                                                 Placeholder="1080"
                                                 IsEnabled="{Binding ProxyEnabled}"
                                                 TextChanged="OnNumericTextChanged"/>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Row="3"
                                                        Grid.Column="0"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate Username, StringFormat='👤 {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding ProxyUsername}"
                                                 SemanticProperties.Description="SOCKS5 proxy username"
                                                 SemanticProperties.Hint="Optional authentication username"
                                                 Placeholder="optional"
                                                 IsEnabled="{Binding ProxyEnabled}"/>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Row="3"
                                                        Grid.Column="1"
                                                        Spacing="4">
                                          <Label Text="{helpers:Translate Password, StringFormat='🔒 {0}'}"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding ProxyPassword}"
                                                 SemanticProperties.Description="SOCKS5 proxy password"
                                                 SemanticProperties.Hint="Optional authentication password"
                                                 Placeholder="optional"
                                                 IsPassword="True"
                                                 IsEnabled="{Binding ProxyEnabled}"/>
                                   </VerticalStackLayout>
                            </Grid>
                     </Border>

                     <Label Text="{Binding ValidationMessage}"
                            SemanticProperties.Description="Settings validation message"
                            TextColor="{StaticResource StatusFailed}"
                            IsVisible="{Binding ValidationMessage, Converter={StaticResource StringNotEmptyConverter}}"
                            FontSize="12"/>
              </VerticalStackLayout>
       </ScrollView>

</ContentPage>