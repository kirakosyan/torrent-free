<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TorrentFree.ViewModels"
             x:Class="TorrentFree.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundColorLight}, Dark={StaticResource PageBackgroundColorDark}}"
             Title="Settings">

       <ScrollView>
              <VerticalStackLayout Padding="16"
                                   Spacing="16">
                     <Label Text="⚙️ Settings"
                            FontSize="22"
                            FontAttributes="Bold"/>

                     <Label Text="Changes are saved automatically."
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>

                     <Border Padding="16"
                             Stroke="Transparent"
                             Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Grid.ColumnSpan="2"
                                          Text="Speed Limits"
                                          FontSize="14"
                                          FontAttributes="Bold"/>

                                   <VerticalStackLayout Grid.Row="1"
                                                        Grid.Column="0"
                                                        Spacing="4">
                                          <Label Text="⬇️ Download KB/s"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding GlobalDownloadLimitKbps}"
                                                 SemanticProperties.Description="Global download speed limit in kilobytes per second"
                                                 SemanticProperties.Hint="Enter zero for unlimited"
                                                 Keyboard="Numeric"
                                                 Placeholder="0 = unlimited"
                                                 TextChanged="OnNumericTextChanged"/>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Row="1"
                                                        Grid.Column="1"
                                                        Spacing="4">
                                          <Label Text="⬆️ Upload KB/s"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding GlobalUploadLimitKbps}"
                                                 SemanticProperties.Description="Global upload speed limit in kilobytes per second"
                                                 SemanticProperties.Hint="Enter zero for unlimited"
                                                 Keyboard="Numeric"
                                                 Placeholder="0 = unlimited"
                                                 TextChanged="OnNumericTextChanged"/>
                                   </VerticalStackLayout>
                            </Grid>
                     </Border>

                     <Border Padding="16"
                             Stroke="Transparent"
                             Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                             IsVisible="{Binding IsFileAssociationSupported}">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Grid.ColumnSpan="2"
                                          Text="File Associations"
                                          FontSize="14"
                                          FontAttributes="Bold"/>
                                   <Label Grid.Row="1"
                                          Grid.Column="0"
                                          Text="Associate .torrent files"
                                          FontSize="12"
                                          TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                   <Switch Grid.Row="1"
                                           Grid.Column="1"
                                           IsToggled="{Binding IsTorrentAssociated}"
                                           SemanticProperties.Description="Associate torrent files with Torrent Free"
                                           SemanticProperties.Hint="Turn on to open .torrent files with this app"/>
                            </Grid>
                     </Border>

                     <Border Padding="16"
                             Stroke="Transparent"
                             Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Grid.ColumnSpan="2"
                                          Text="Queue Limits"
                                          FontSize="14"
                                          FontAttributes="Bold"/>

                                   <VerticalStackLayout Grid.Row="1"
                                                        Grid.Column="0"
                                                        Spacing="4">
                                          <Label Text="⬇️ Max Active Downloads"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding MaxActiveDownloads}"
                                                 SemanticProperties.Description="Maximum number of active downloads"
                                                 SemanticProperties.Hint="Enter zero for unlimited"
                                                 Keyboard="Numeric"
                                                 Placeholder="0 = unlimited"
                                                 TextChanged="OnNumericTextChanged"/>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Row="1"
                                                        Grid.Column="1"
                                                        Spacing="4">
                                          <Label Text="🌱 Max Active Seeds"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding MaxActiveSeeds}"
                                                 SemanticProperties.Description="Maximum number of active seed jobs"
                                                 SemanticProperties.Hint="Enter zero for unlimited"
                                                 Keyboard="Numeric"
                                                 Placeholder="0 = unlimited"
                                                 TextChanged="OnNumericTextChanged"/>
                                   </VerticalStackLayout>
                            </Grid>
                     </Border>

                     <Border Padding="16"
                             Stroke="Transparent"
                             Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Grid.ColumnSpan="2"
                                          Text="Seeding Limits"
                                          FontSize="14"
                                          FontAttributes="Bold"/>

                                   <VerticalStackLayout Grid.Row="1"
                                                        Grid.Column="0"
                                                        Spacing="4">
                                          <Label Text="📊 Max Seed Ratio"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding GlobalMaxSeedRatio}"
                                                 SemanticProperties.Description="Global maximum seed ratio"
                                                 SemanticProperties.Hint="Enter zero for unlimited"
                                                 Keyboard="Numeric"
                                                 Placeholder="0 = unlimited"
                                                 TextChanged="OnDecimalTextChanged"/>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Row="1"
                                                        Grid.Column="1"
                                                        Spacing="4">
                                          <Label Text="⏱️ Max Seed Minutes"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding GlobalMaxSeedMinutes}"
                                                 SemanticProperties.Description="Global maximum seed minutes"
                                                 SemanticProperties.Hint="Enter zero for unlimited"
                                                 Keyboard="Numeric"
                                                 Placeholder="0 = unlimited"
                                                 TextChanged="OnNumericTextChanged"/>
                                   </VerticalStackLayout>
                            </Grid>
                     </Border>

                     <!-- Proxy Settings -->
                     <Border StrokeShape="RoundRectangle 12"
                             Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                             Padding="16">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Grid.ColumnSpan="2"
                                          Text="SOCKS5 Proxy"
                                          FontSize="14"
                                          FontAttributes="Bold"/>

                                   <HorizontalStackLayout Grid.Row="1"
                                                          Grid.ColumnSpan="2"
                                                          Spacing="8">
                                          <Switch IsToggled="{Binding ProxyEnabled}"
                                                  SemanticProperties.Description="Enable SOCKS5 proxy"/>
                                          <Label Text="Enable Proxy"
                                                 VerticalOptions="Center"
                                                 FontSize="13"/>
                                   </HorizontalStackLayout>

                                   <VerticalStackLayout Grid.Row="2"
                                                        Grid.Column="0"
                                                        Spacing="4">
                                          <Label Text="🌐 Host"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding ProxyHost}"
                                                 SemanticProperties.Description="SOCKS5 proxy host address"
                                                 SemanticProperties.Hint="Enter proxy host or IP"
                                                 Placeholder="e.g. 127.0.0.1"
                                                 IsEnabled="{Binding ProxyEnabled}"/>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Row="2"
                                                        Grid.Column="1"
                                                        Spacing="4">
                                          <Label Text="🔌 Port"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding ProxyPort}"
                                                 SemanticProperties.Description="SOCKS5 proxy port"
                                                 SemanticProperties.Hint="Enter proxy port number"
                                                 Keyboard="Numeric"
                                                 Placeholder="1080"
                                                 IsEnabled="{Binding ProxyEnabled}"
                                                 TextChanged="OnNumericTextChanged"/>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Row="3"
                                                        Grid.Column="0"
                                                        Spacing="4">
                                          <Label Text="👤 Username"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding ProxyUsername}"
                                                 SemanticProperties.Description="SOCKS5 proxy username"
                                                 SemanticProperties.Hint="Optional authentication username"
                                                 Placeholder="optional"
                                                 IsEnabled="{Binding ProxyEnabled}"/>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Row="3"
                                                        Grid.Column="1"
                                                        Spacing="4">
                                          <Label Text="🔒 Password"
                                                 FontSize="11"
                                                 TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                          <Entry Text="{Binding ProxyPassword}"
                                                 SemanticProperties.Description="SOCKS5 proxy password"
                                                 SemanticProperties.Hint="Optional authentication password"
                                                 Placeholder="optional"
                                                 IsPassword="True"
                                                 IsEnabled="{Binding ProxyEnabled}"/>
                                   </VerticalStackLayout>
                            </Grid>
                     </Border>

                     <Label Text="{Binding ValidationMessage}"
                            SemanticProperties.Description="Settings validation message"
                            TextColor="{StaticResource StatusFailed}"
                            IsVisible="{Binding ValidationMessage, Converter={StaticResource StringNotEmptyConverter}}"
                            FontSize="12"/>
              </VerticalStackLayout>
       </ScrollView>

</ContentPage>