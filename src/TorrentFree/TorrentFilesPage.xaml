<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TorrentFree.Models;assembly=TorrentFree.Core"
             xmlns:helpers="clr-namespace:TorrentFree.Helpers"
             x:Class="TorrentFree.TorrentFilesPage"
             x:Name="FilesPage"
             x:DataType="models:TorrentFileSelectionViewModel"
             Title="{helpers:Translate ChooseFiles}"
             BackgroundColor="{AppThemeBinding Light=#F5F7FB, Dark=#101522}"
             SafeAreaEdges="All">
    <Grid x:Name="LayoutRoot" Padding="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" MaximumWidthRequest="760" HorizontalOptions="Fill" SizeChanged="OnLayoutSizeChanged">
        <Grid x:Name="HeaderLayout" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="6" ColumnSpacing="12">
            <Label x:Name="Heading" Grid.ColumnSpan="2" Text="{helpers:Translate ChooseFiles}" FontSize="24" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1"/>
            <Label x:Name="TorrentName" Grid.Row="1" Grid.ColumnSpan="2" FontSize="14" MaxLines="2" LineBreakMode="TailTruncation" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#526078, Dark=#B8C4DA}"/>
            <Label x:Name="HelpLabel" Grid.Row="2" Grid.ColumnSpan="2" Text="{helpers:Translate FileSelectionHelp}" FontSize="13"
                   TextColor="{AppThemeBinding Light=#526078, Dark=#B8C4DA}"/>
        </Grid>
        <Grid x:Name="SelectionTools" Grid.Row="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="12" IsVisible="False">
            <SearchBar x:Name="FileSearch" Grid.ColumnSpan="2" Text="{Binding SearchText}" Placeholder="{helpers:Translate SearchFiles}"
                       SearchButtonPressed="OnSearchButtonPressed"
                       SemanticProperties.Description="{helpers:Translate SearchFiles}"/>
            <Grid x:Name="BulkActions" Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="{helpers:Translate SelectShown}" Command="{Binding SelectAllCommand}"
                        BackgroundColor="{AppThemeBinding Light=#E5EBF6, Dark=#26334A}"
                        TextColor="{AppThemeBinding Light=#234B8A, Dark=#DBE8FF}" MinimumHeightRequest="44" LineBreakMode="WordWrap"/>
                <Button Grid.Column="1" Text="{helpers:Translate ClearShown}" Command="{Binding SelectNoneCommand}"
                        BackgroundColor="{AppThemeBinding Light=#E5EBF6, Dark=#26334A}"
                        TextColor="{AppThemeBinding Light=#234B8A, Dark=#DBE8FF}" MinimumHeightRequest="44" LineBreakMode="WordWrap"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="2">
            <CollectionView x:Name="FileList" ItemsSource="{Binding VisibleFiles}" SelectionMode="None" IsVisible="False">
                <CollectionView.EmptyView>
                    <Label Text="{helpers:Translate NoMatchingFiles}" Padding="16" HorizontalTextAlignment="Center"/>
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <Label x:Name="ScrollableNote" Text="{helpers:Translate FileSelectionNote}" FontSize="11" Padding="0,8" IsVisible="False"
                           TextColor="{AppThemeBinding Light=#526078, Dark=#B8C4DA}"/>
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TorrentFileChoice">
                        <Border Margin="0,0,0,6" Padding="8" StrokeThickness="1" StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light=#DCE3EF, Dark=#334158}"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1A2333}">
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="8" MinimumHeightRequest="52">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Color="#4285F4"
                                          SemanticProperties.Description="{Binding Path}" VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference FilesPage}, Path=BindingContext.ToggleFileCommand, x:DataType=ContentPage}" CommandParameter="{Binding .}"/>
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="2"/>
                                    <Label Text="{Binding Folder}" IsVisible="{Binding HasFolder}" FontSize="12" LineBreakMode="MiddleTruncation" MaxLines="1"
                                           TextColor="{AppThemeBinding Light=#526078, Dark=#B8C4DA}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding SizeLabel}" FontSize="12" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#526078, Dark=#B8C4DA}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <VerticalStackLayout x:Name="LoadingPanel" VerticalOptions="Center" Spacing="14">
                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="True" Color="#4285F4"/>
                <Label x:Name="LoadingMessage" Text="{helpers:Translate LoadingTorrentFiles}" HorizontalTextAlignment="Center"/>
                <Button x:Name="RetryButton" Text="{helpers:Translate RetryFiles}" Clicked="OnRetryClicked" IsVisible="False" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>
        <Grid x:Name="FooterLayout" Grid.Row="3" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10" ColumnSpacing="16">
            <Label x:Name="SummaryLabel" Grid.ColumnSpan="2" Text="{Binding Summary}" FontSize="15" FontAttributes="Bold" IsVisible="False" VerticalOptions="Center"/>
            <Label x:Name="SelectionError" Grid.Row="1" Grid.ColumnSpan="2" FontSize="13" TextColor="{AppThemeBinding Light=#B3261E, Dark=#FFB4AB}" IsVisible="False"/>
            <Label x:Name="SelectionNote" Grid.Row="2" Grid.ColumnSpan="2" Text="{helpers:Translate FileSelectionNote}" FontSize="11"
                   TextColor="{AppThemeBinding Light=#526078, Dark=#B8C4DA}"/>
            <Grid x:Name="ConfirmationActions" Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Button x:Name="CancelButton" Text="{helpers:Translate Cancel}" Clicked="OnCancelClicked"
                        BackgroundColor="{AppThemeBinding Light=#E5EBF6, Dark=#26334A}" TextColor="{AppThemeBinding Light=#234B8A, Dark=#DBE8FF}" MinimumHeightRequest="48" MinimumWidthRequest="90" LineBreakMode="WordWrap"/>
                <Button x:Name="ConfirmButton" Grid.Column="1" Text="{helpers:Translate ApplyFileSelection}" Clicked="OnConfirmClicked"
                        IsEnabled="{Binding CanConfirm}" BackgroundColor="#2563EB" TextColor="White" MinimumHeightRequest="48" LineBreakMode="WordWrap"/>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
