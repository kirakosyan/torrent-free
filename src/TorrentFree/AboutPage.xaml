<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:TorrentFree.Helpers"
             x:Class="TorrentFree.AboutPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundColorLight}, Dark={StaticResource PageBackgroundColorDark}}"
             SafeAreaEdges="Container"
             Title="{helpers:Translate AboutTitle}">
    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="20"
          MaximumWidthRequest="600" HorizontalOptions="Fill">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Text="{helpers:Translate AboutTitle}"
                   FontSize="22" FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1"
                   VerticalOptions="Center"/>
            <Button Grid.Column="1" Text="{helpers:Translate OK}"
                    Clicked="OnCloseClicked" VerticalOptions="Center"/>
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="AboutActions" Spacing="20">
                <Label x:Name="AboutMessageLabel" FontSize="14"/>
                <Button x:Name="FeedbackButton"
                        Text="{helpers:Translate StoreFeedbackAction}"
                        SemanticProperties.Hint="{helpers:Translate StoreFeedbackHint}"
                        Clicked="OnFeedbackClicked"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
