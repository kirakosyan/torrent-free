<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:TorrentFree.Helpers"
             x:Class="TorrentFree.AboutPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundColorLight}, Dark={StaticResource PageBackgroundColorDark}}"
             SafeAreaEdges="Container"
             Title="{helpers:Translate AboutTitle}">
    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="20"
          MaximumWidthRequest="600" HorizontalOptions="Fill">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Text="{helpers:Translate AboutTitle}"
                   FontSize="22" FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1"
                   VerticalOptions="Center"/>
            <Button Grid.Column="1" Text="{helpers:Translate OK}"
                    Clicked="OnCloseClicked" VerticalOptions="Center"/>
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20">
                <Label x:Name="AboutMessageLabel" FontSize="14"/>
                <Button Text="{helpers:Translate OpenSource}"
                        SemanticProperties.Hint="{helpers:Translate OpenInDefaultBrowser}"
                        Clicked="OnSourceClicked"/>
                <Border Padding="20" StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1F2937}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{helpers:Translate SupportProjectTitle, StringFormat='♥ {0}'}"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#B42345, Dark=#FDA4AF}"
                               SemanticProperties.HeadingLevel="Level2"/>
                        <Label Text="{helpers:Translate SupportProjectMessage}"
                               FontSize="14"/>
                        <Button Text="{helpers:Translate SupportOnPatreon}"
                                SemanticProperties.Hint="{helpers:Translate OpenInDefaultBrowser}"
                                Clicked="OnPatreonClicked"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
