<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TorrentFree"
             xmlns:helpers="clr-namespace:TorrentFree.Helpers"
             x:Class="TorrentFree.DeleteTorrentDialogPage"
             x:DataType="local:DeleteTorrentDialogViewModel"
             BackgroundColor="#80000000"
             SafeAreaEdges="Container"
             Padding="24">

       <Grid RowDefinitions="*"
             ColumnDefinitions="*">
              <Frame Padding="20"
                     CornerRadius="12"
                     BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D30}"
                     HasShadow="True"
                     VerticalOptions="Center"
                     HorizontalOptions="Center"
                     MaximumWidthRequest="420">
                     <VerticalStackLayout Spacing="16">
                            <Label Text="{helpers:Translate RemoveTorrent}"
                                   FontSize="18"
                                   FontAttributes="Bold"/>
                            <Label Text="{helpers:Translate DeleteFilesOptional}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                            <Label Text="{Binding TorrentName}"
                                   FontSize="14"
                                   FontAttributes="Bold"/>

                             <HorizontalStackLayout Spacing="8">
                                    <CheckBox IsChecked="{Binding DeleteTorrentFile}"
                                             SemanticProperties.Description="{helpers:Translate DeleteTorrentFile}"
                                             SemanticProperties.Hint="{helpers:Translate DeleteTorrentFileHint}"/>
                                    <Label Text="{helpers:Translate DeleteTorrentFile}"
                                           VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                             <HorizontalStackLayout Spacing="8">
                                    <CheckBox IsChecked="{Binding DeleteDownloadedFiles}"
                                             SemanticProperties.Description="{helpers:Translate DeleteDownloadedFiles}"
                                             SemanticProperties.Hint="{helpers:Translate DeleteDownloadedFilesHint}"/>
                                    <Label Text="{helpers:Translate DeleteDownloadedFiles}"
                                           VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="12"
                                                   HorizontalOptions="End">
                                    <Button Text="{helpers:Translate Cancel}"
                                           SemanticProperties.Description="{helpers:Translate Cancel}"
                                           BackgroundColor="#BDBDBD"
                                           TextColor="White"
                                           Clicked="OnCancelClicked"/>
                                    <Button Text="{helpers:Translate RemoveButton}"
                                           SemanticProperties.Description="{helpers:Translate RemoveButton}"
                                           SemanticProperties.Hint="{helpers:Translate RemoveTorrentHint}"
                                           BackgroundColor="#E53935"
                                           TextColor="White"
                                           Clicked="OnDeleteClicked"/>
                            </HorizontalStackLayout>
                     </VerticalStackLayout>
              </Frame>
       </Grid>
</ContentPage>
